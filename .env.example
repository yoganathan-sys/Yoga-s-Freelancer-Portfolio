# ==============================================================================
# Yoganathan A — Freelancer Portfolio Environment Variables
# ==============================================================================
# Instructions: Copy this file to .env.local and fill in your actual credentials.
# Note: In development mode, the app includes full mock/fallback support so that
# the portfolio, project detail pages, and UI work even before Supabase is connected!
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Supabase Service Role Key (SERVER-ONLY, NEVER expose to the browser)
# Required for admin backend operations that bypass RLS (e.g. contact inquiry routing)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# Resend Email Configuration (Automatic Client Enquiry Notifications)
# ------------------------------------------------------------------------------
# 1. Create a free account at https://resend.com
# 2. Generate an API Key under "API Keys" -> https://resend.com/api-keys
# 3. Paste the key here (starts with "re_"):
RESEND_API_KEY="re_1234567890abcdef"

# Primary recipient email for client enquiries (Yoganathan A)
CONTACT_NOTIFICATION_EMAIL="yoganathan162008@gmail.com"

# Verified sender address:
# - For rapid local testing without a domain: "Portfolio Contact <onboarding@resend.dev>"
#   (Note: onboarding@resend.dev can only deliver to the email you registered on Resend)
# - For production with your custom domain: "Portfolio Contact <inquiry@yourdomain.com>"
#   (Verify your DNS records in https://resend.com/domains)
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Authorized Administrator Email (used for admin portal access)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="yoganathan162008@gmail.com"

# ------------------------------------------------------------------------------
# Site URL for metadata, Open Graph, and sitemap generation
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://yoganathan.dev"
